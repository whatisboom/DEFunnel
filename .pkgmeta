package-as: DEFunnel

# Mark BoomForge as a required dependency on the CurseForge upload (by project
# slug). `## RequiredDeps` in the .toc only affects the game client; without this,
# CurseForge and its app don't know to install BoomForge alongside DEFunnel.
required-dependencies:
  - boomforge

manual-changelog: CHANGELOG.md
license-output: LICENSE

# Ace3 + LibDataBroker/LibDBIcon are no longer vendored here -- they're
# provided by BoomForge (## RequiredDeps: BoomForge in DEFunnel.toc).

ignore:
  - scripts
  - tests
  - CLAUDE.md
